{% import "_includes/forms" as forms %}

{{ forms.autosuggestField({
    label: 'Loki API key'|t('loki-logger'),
    instructions: 'Sent as the X-Api-Key header on every push. Leave blank to disable sending (handy for local/dev).'|t('loki-logger'),
    id: 'apiKey',
    name: 'apiKey',
    suggestEnvVars: true,
    value: settings.apiKey,
    errors: settings.getErrors('apiKey'),
}) }}

{{ forms.autosuggestField({
    label: 'Loki push URL'|t('loki-logger'),
    instructions: 'Loki HTTP push endpoint. Required: sending is disabled while this is blank.'|t('loki-logger'),
    id: 'pushUrl',
    name: 'pushUrl',
    placeholder: 'https://loki.example.com/loki/api/v1/push',
    suggestEnvVars: true,
    value: settings.pushUrl,
    errors: settings.getErrors('pushUrl'),
}) }}

{{ forms.autosuggestField({
    label: 'Site label'|t('loki-logger'),
    instructions: 'Value of the `site` Loki stream label, identifying this site in Grafana (e.g. "www.client.com"). Should be the production website domain for all environments. Blank uses the primary site host.'|t('loki-logger'),
    id: 'site',
    name: 'site',
    suggestEnvVars: true,
    value: settings.site,
    errors: settings.getErrors('site'),
}) }}

{{ forms.autosuggestField({
    label: 'Host label'|t('loki-logger'),
    instructions: 'Value of the `host` Loki stream label, identifying the server (e.g. "web1"). Blank uses the machine hostname. Keep it stable and low-cardinality.'|t('loki-logger'),
    id: 'host',
    name: 'host',
    suggestEnvVars: true,
    value: settings.host,
    errors: settings.getErrors('host'),
}) }}

{{ forms.editableTableField({
    label: 'Suppressed logs'|t('loki-logger'),
    instructions: 'Log lines matching any row are never sent to Loki. Category is the line\'s `channel` in Grafana, matched exactly or by prefix when it ends in `*`. Exceptions use their class name, except HTTP exceptions, which all use `yii\\web\\HttpException:<status>` (e.g. `yii\\web\\HttpException:400`). Message is a case-sensitive substring of the log message. A blank field matches anything, so a row needs at least one of the two.'|t('loki-logger'),
    id: 'suppress',
    name: 'suppress',
    cols: {
        category: {
            heading: 'Category'|t('loki-logger'),
            type: 'singleline',
            code: true,
            placeholder: 'yii\\web\\HttpException:400',
        },
        message: {
            heading: 'Message contains'|t('loki-logger'),
            type: 'singleline',
            placeholder: 'Invalid token',
        },
    },
    rows: settings.suppress,
    allowAdd: true,
    allowDelete: true,
    allowReorder: true,
    addRowLabel: 'Add a rule'|t('loki-logger'),
    errors: settings.getErrors('suppress'),
}) }}
